# Models: everything runs on Together AI (GLM-5.3, GLM-5.3 Flash, DeepSeek V4.1 Flash)
TOGETHER_API_KEY=
# Langfuse Cloud (https://cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Region matters: EU https://cloud.langfuse.com, US https://us.cloud.langfuse.com, JP https://jp.cloud.langfuse.com
# (LANGFUSE_BASE_URL is accepted too)
LANGFUSE_HOST=https://cloud.langfuse.com
# Evaboot (optional until you have API access)
EVABOOT_API_KEY=
EVABOOT_WEBHOOK_SECRET=change-me
PUBLIC_WEBHOOK_URL=
# Telegram: token from @BotFather; `sdr-loop start` fills in the chat id for you
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Demo email delivery: approved emails go to a local Mailpit inbox (docker compose up -d mailpit),
# never to the real address. off = outbox.jsonl only.
EMAIL_MODE=off
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_URL=http://localhost:8025
FOLLOWUP_DELAY_MINUTES=3
# Storage
DATABASE_URL=sqlite+aiosqlite:///./sdr_loop.db
OUTBOX_PATH=outbox.jsonl
# Background job records and logs
STATE_DIR=.sdr-loop
# Who we are and what the writer may claim (edited on the Setup page)
CAMPAIGN_PATH=campaign.yaml
# Behaviour
DRY_RUN=true
LEARN_ENABLED=true
# Local time of the nightly learning cycle while `sdr-loop start` runs
LEARN_AT=02:00
OFFLINE=false
CONCURRENCY=5
PER_LEAD_USD_CAP=0.05
PER_LEAD_TOKEN_CAP=40000
PER_RUN_USD_CAP=5.0
MAX_TOOL_CALLS=3
# GLM-5.3 always thinks; this shortens the trace: low | medium | high | max
GLM_REASONING_EFFORT=low
